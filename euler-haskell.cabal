cabal-version:       2.2

name:                euler-haskell
version:             0.1.0.0
homepage:            https://github.com/neillrobson/euler-haskell#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Neill Robson
maintainer:          neill@neillrobson.com
copyright:           2026 - Present
category:            education
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable euler-haskell
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    Haskell2010
  default-extensions:  DataKinds
  build-depends:       base >= 4.7 && < 5, array, containers
  ghc-options:         -Wall

source-repository head
  type:     git
  location: https://github.com/neillrobson/euler-haskell
